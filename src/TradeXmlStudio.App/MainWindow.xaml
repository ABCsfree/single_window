<Window x:Class="TradeXmlStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trade XML Studio" Width="1120" Height="790"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="22,15">
            <StackPanel>
                <TextBlock Text="Trade XML Studio" Foreground="White" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="ELBP004 信息补录与 ELBP005 随附单据生成" Foreground="#CBD5E1" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16" Background="White">
            <TabItem Header="单笔生成">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="照片文件夹" />
                        <TextBox x:Name="SourceFolderTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4" TextChanged="SingleInputChanged" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Click="BrowseSourceFolder_Click" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="输出目录" />
                        <TextBox x:Name="OutputFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                        <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Click="BrowseOutputFolder_Click" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="通知编号" />
                        <TextBox x:Name="SeqNoTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" MaxLength="50" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="生产批次号" />
                        <TextBox x:Name="ProBatchNumberTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" MaxLength="50" />

                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="商品项号" />
                        <TextBox x:Name="GNoTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" MaxLength="18" />

                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="箱号" />
                        <TextBox x:Name="LotIdTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" MaxLength="255" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="影像预览（按文件名排序后映射为 A1-A4）"
                               Margin="0,16,0,8" FontWeight="SemiBold" Foreground="#111827" />
                    <ListView x:Name="PhotoPreviewListView" Grid.Row="2" BorderBrush="#D1D5DB">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="业务类型" Width="85" DisplayMemberBinding="{Binding BizTypeCode}" />
                                <GridViewColumn Header="文件名" Width="360" DisplayMemberBinding="{Binding FileName}" />
                                <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="完整路径" Width="350" DisplayMemberBinding="{Binding FullPath}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="OpenOutputFolderButton" Content="打开输出目录" IsEnabled="False" Click="OpenOutputFolder_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="生成 XML" Click="GenerateXml_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Excel 批量生成">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Excel 文件" />
                        <TextBox x:Name="BatchExcelPathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4" IsReadOnly="True" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Click="BrowseBatchExcel_Click" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="工作表" />
                        <ComboBox x:Name="BatchSheetComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                  SelectionChanged="BatchSheet_Changed" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="通知编号" />
                        <TextBox x:Name="BatchSeqNoTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" MaxLength="50" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="生产批次号" />
                        <TextBox x:Name="BatchProBatchNumberTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" MaxLength="50" />

                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="影像根目录" />
                        <TextBox x:Name="BatchBigFolderTextBox" Grid.Row="4" Grid.Column="1" Margin="0,4" TextChanged="BatchInputChanged" />
                        <Button Grid.Row="4" Grid.Column="2" Content="浏览…" Click="BrowseBatchBigFolder_Click" />

                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="匹配模式" />
                        <ComboBox x:Name="BatchFolderModeComboBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                  SelectedIndex="0" SelectionChanged="BatchFolderMode_Changed">
                            <ComboBoxItem Content="每个箱号对应一个同名小文件夹" />
                            <ComboBoxItem Content="每个序号对应一个同名小文件夹" />
                            <ComboBoxItem Content="所有照片位于一个大文件夹（数字前缀匹配箱号尾号）" />
                        </ComboBox>

                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="输出目录" />
                        <TextBox x:Name="BatchOutputFolderTextBox" Grid.Row="6" Grid.Column="1" Margin="0,4" />
                        <Button Grid.Row="6" Grid.Column="2" Content="浏览…" Click="BrowseBatchOutputFolder_Click" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="批量预览（B 列序号，C 列箱号）"
                               Margin="0,16,0,8" FontWeight="SemiBold" Foreground="#111827" />
                    <ListView x:Name="BatchResultListView" Grid.Row="2" BorderBrush="#D1D5DB">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="序号" Width="65" DisplayMemberBinding="{Binding Serial}" />
                                <GridViewColumn Header="箱号" Width="190" DisplayMemberBinding="{Binding LotId}" />
                                <GridViewColumn Header="照片数" Width="75" DisplayMemberBinding="{Binding PhotoCount}" />
                                <GridViewColumn Header="状态" Width="130" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="详情/目录" Width="590" DisplayMemberBinding="{Binding Detail}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="OpenBatchFolderButton" Content="打开输出目录" IsEnabled="False" Click="OpenBatchFolder_Click" />
                        <Button x:Name="GenerateBatchButton" Style="{StaticResource PrimaryButton}" Content="批量生成" Click="GenerateBatch_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="公共配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="以下字段由用户分别填写，同时用于单笔和批量生成。签名由单一窗口导入客户端完成。"
                                   Foreground="#6B7280" Margin="0,0,0,14" />

                        <GroupBox Header="操作信息" Margin="0,0,0,12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="500" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="操作人代码（ICCode）" />
                                <TextBox x:Name="ICCodeTextBox" Grid.Row="0" Grid.Column="1" Margin="0,5" MaxLength="13" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="企业组织机构代码（CopCode）" />
                                <TextBox x:Name="CopCodeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5" MaxLength="18" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="操作人姓名" />
                                <TextBox x:Name="OperNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,5" MaxLength="30" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="出口企业（独立填写）" Margin="0,0,0,12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="500" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="出口企业名称" />
                                <TextBox x:Name="ExportNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,5" MaxLength="70" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="出口企业海关十位编码" />
                                <TextBox x:Name="ExportCustomsCodeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5" MaxLength="10" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="出口企业统一社会信用代码" />
                                <TextBox x:Name="ExportSccTextBox" Grid.Row="2" Grid.Column="1" Margin="0,5" MaxLength="18" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="4位主管海关代码" />
                                <TextBox x:Name="SupervisingCustomsCodeTextBox" Grid.Row="3" Grid.Column="1" Margin="0,5" MaxLength="4" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="申请单位（独立填写）" Margin="0,0,0,12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="500" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="申请单位名称" />
                                <TextBox x:Name="AgentNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,5" MaxLength="70" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="申请单位海关十位编码" />
                                <TextBox x:Name="AgentCustomsCodeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5" MaxLength="10" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="申请单位统一社会信用代码" />
                                <TextBox x:Name="AgentSccTextBox" Grid.Row="2" Grid.Column="1" Margin="0,5" MaxLength="18" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="附件设置" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="500" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="上传类型代码" />
                                <ComboBox x:Name="UploadTypeCodeComboBox" Grid.Row="0" Grid.Column="1" Margin="0,5" SelectedIndex="1">
                                    <ComboBoxItem Content="P" /><ComboBoxItem Content="F" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="原附件大小上限（MB）" />
                                <TextBox x:Name="MaxImageMbTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5" Text="2.25" TextChanged="SingleInputChanged" />
                                <CheckBox x:Name="P0IncludeCheckBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,5"
                                          Content="包含代理委托协议（P0，单独生成 ELBP005 并写入 ELBP004 清单）"
                                          Checked="P0IncludeChanged" Unchecked="P0IncludeChanged" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="P0 文件" />
                                <TextBox x:Name="P0FilePathTextBox" Grid.Row="3" Grid.Column="1" Margin="0,5" TextChanged="SingleInputChanged" />
                                <Button Grid.Row="3" Grid.Column="2" Content="浏览…" Click="BrowseP0File_Click" />
                            </Grid>
                        </GroupBox>

                        <Button HorizontalAlignment="Left" Margin="190,20,0,20"
                                Style="{StaticResource PrimaryButton}" Content="保存配置" Click="SaveConfig_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="16,10">
            <TextBlock x:Name="StatusTextBlock" Text="就绪" Foreground="#374151" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
